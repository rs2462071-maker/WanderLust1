<% layout("/layouts/boilerplate") %>

<!-- ================= SEARCH BAR ================= -->

<div class="container mt-4">

    <form action="/listings" method="GET" class="search-bar">

        <!-- LOCATION -->

        <div class="search-item">
            <label for="location">Where</label>

            <input
                type="text"
                id="location"
                name="location"
                placeholder="Search destinations"
            >
        </div>


        <!-- CHECK IN -->

        <div class="search-item">

            <label for="checkIn">
                Check in
            </label>

            <input
                type="date"
                id="checkIn"
                name="checkIn"
            >

        </div>


        <!-- CHECK OUT -->

        <div class="search-item">

            <label for="checkOut">
                Check out
            </label>

            <input
                type="date"
                id="checkOut"
                name="checkOut"
            >

        </div>


        <!-- GUESTS -->

        <div class="search-item">

            <label for="guests">
                Guests
            </label>

            <input
                type="number"
                id="guests"
                name="guests"
                min="1"
                placeholder="Add guests"
            >

        </div>


        <!-- SEARCH BUTTON -->

        <button
            type="submit"
            class="search-btn"
        >

            <i class="fa-solid fa-magnifying-glass"></i>

        </button>

    </form>

</div>


<!-- ================= FILTER + TAX ================= -->

<div class="container mt-4">

    <div class="filter-wrapper">

        <!-- FILTERS -->

        <div class="filter-container">

            <button
                type="button"
                class="filter-btn active"
            >
                All
            </button>


            <button
                type="button"
                class="filter-btn"
            >
                <i class="fa-solid fa-house"></i>
                Homes
            </button>


            <button
                type="button"
                class="filter-btn"
            >
                <i class="fa-solid fa-mountain"></i>
                Mountains
            </button>


            <button
                type="button"
                class="filter-btn"
            >
                <i class="fa-solid fa-water"></i>
                Beach
            </button>


            <button
                type="button"
                class="filter-btn"
            >
                <i class="fa-solid fa-city"></i>
                City
            </button>


            <button
                type="button"
                class="filter-btn"
            >
                <i class="fa-solid fa-tree"></i>
                Countryside
            </button>

        </div>


        <!-- TAX SWITCH -->

        <div class="tax-switch">

            <span>
                Display total before taxes
            </span>

            <label class="switch">

                <input
                    type="checkbox"
                    id="taxToggle"
                >

                <span class="slider"></span>

            </label>

        </div>

    </div>

</div>


<!-- ================= LISTINGS ================= -->

<div class="container mt-4">

    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4">

        <% for(let listing of allListings) { %>

            <div class="col">

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >

                    <!-- LISTING CARD -->

                    <div class="listing-card">


                        <!-- IMAGE -->

                        <div class="image-wrapper">

                            <img
                                src="<%= listing.image?.url || '/images/default.jpg' %>"
                                class="listing-image"
                                alt="<%= listing.title %>"
                            >


                            <!-- HEART -->

                            <button
                                type="button"
                                class="heart-btn"
                                onclick="event.preventDefault()"
                            >

                                <i class="fa-regular fa-heart"></i>

                            </button>

                        </div>


                        <!-- INFORMATION -->

                        <div class="listing-info">

                            <h5>
                                <%= listing.title %>
                            </h5>


                            <p class="location">

                                <%= listing.location %>

                            </p>


                            <!-- PRICE -->

                            <p class="price">

                                ₹

                                <span
                                    class="listing-price"
                                    data-price="<%= listing.price %>"
                                >
                                    <%= listing.price.toLocaleString("en-IN") %>
                                </span>

                                <span class="price-unit">
                                    night
                                </span>

                            </p>

                        </div>

                    </div>

                </a>

            </div>

        <% } %>

    </div>

</div>


<!-- ================= CSS ================= -->

<style>

/* ================= SEARCH ================= */

.search-bar {

    display: flex;

    align-items: center;

    background: white;

    border: 1px solid #ddd;

    border-radius: 50px;

    padding: 7px;

    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);

}


.search-item {

    flex: 1;

    padding: 8px 20px;

    border-right: 1px solid #ddd;

}


.search-item label {

    display: block;

    font-size: 12px;

    font-weight: 600;

    margin-bottom: 2px;

}


.search-item input {

    border: none;

    outline: none;

    width: 100%;

    font-size: 14px;

}


.search-btn {

    width: 45px;

    height: 45px;

    border: none;

    border-radius: 50%;

    background: #ff385c;

    color: white;

    cursor: pointer;

}


.search-btn:hover {

    opacity: 0.9;

}


/* ================= FILTER ================= */

.filter-wrapper {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

}


.filter-container {

    display: flex;

    gap: 10px;

    overflow-x: auto;

    padding-bottom: 5px;

}


.filter-btn {

    border: none;

    background: transparent;

    padding: 10px 15px;

    border-radius: 10px;

    white-space: nowrap;

    color: #555;

}


.filter-btn:hover {

    background: #f2f2f2;

    color: #111;

}


.filter-btn.active {

    background: #f2f2f2;

    color: #111;

}


/* ================= TAX SWITCH ================= */

.tax-switch {

    display: flex;

    align-items: center;

    gap: 10px;

    border: 1px solid #ddd;

    border-radius: 12px;

    padding: 10px 15px;

    white-space: nowrap;

}


.tax-switch > span {

    font-size: 14px;

}


/* SWITCH */

.switch {

    position: relative;

    display: inline-block;

    width: 45px;

    height: 25px;

}


.switch input {

    opacity: 0;

    width: 0;

    height: 0;

}


.slider {

    position: absolute;

    inset: 0;

    background: #777;

    border-radius: 30px;

    cursor: pointer;

    transition: 0.3s;

}


.slider:before {

    content: "";

    position: absolute;

    width: 19px;

    height: 19px;

    left: 3px;

    top: 3px;

    background: white;

    border-radius: 50%;

    transition: 0.3s;

}


.switch input:checked + .slider {

    background: #222;

}


.switch input:checked + .slider:before {

    transform: translateX(20px);

}


/* ================= LISTING ================= */

.listing-link {

    text-decoration: none;

    color: inherit;

}


.listing-card {

    transition: 0.2s;

}


.listing-card:hover {

    transform: translateY(-3px);

}


/* IMAGE */

.image-wrapper {

    position: relative;

}


.listing-image {

    width: 100%;

    height: 260px;

    object-fit: cover;

    border-radius: 15px;

}


/* HEART */

.heart-btn {

    position: absolute;

    top: 12px;

    right: 12px;

    border: none;

    background: white;

    width: 36px;

    height: 36px;

    border-radius: 50%;

    cursor: pointer;

}


.heart-btn:hover {

    transform: scale(1.05);

}


/* INFO */

.listing-info {

    padding-top: 10px;

}


.listing-info h5 {

    font-size: 16px;

    margin-bottom: 4px;

}


.location {

    color: #777;

    margin-bottom: 5px;

}


.price {

    font-weight: 600;

    margin-bottom: 0;

}


.price-unit {

    font-weight: normal;

    color: #555;

}


/* ================= MOBILE ================= */

@media (max-width: 768px) {

    .search-bar {

        flex-direction: column;

        align-items: stretch;

        border-radius: 20px;

    }


    .search-item {

        border-right: none;

        border-bottom: 1px solid #eee;

    }


    .search-btn {

        width: 100%;

        border-radius: 12px;

        margin-top: 5px;

    }


    .filter-wrapper {

        flex-direction: column;

        align-items: stretch;

    }


    .tax-switch {

        width: 100%;

        justify-content: space-between;

    }


    .listing-image {

        height: 230px;

    }

}

</style>


<!-- ================= JAVASCRIPT ================= -->

<script>

    const taxToggle = document.getElementById("taxToggle");

    const TAX_RATE = 0.18;


    taxToggle.addEventListener("change", function () {

        const prices =
            document.querySelectorAll(".listing-price");


        prices.forEach(priceElement => {

            const basePrice =
                Number(priceElement.dataset.price);


            if (this.checked) {

                // Add 18% tax

                const total =
                    basePrice + (basePrice * TAX_RATE);


                priceElement.innerText =
                    Math.round(total)
                    .toLocaleString("en-IN");

            }

            else {

                // Show original price

                priceElement.innerText =
                    basePrice
                    .toLocaleString("en-IN");

            }

        });

    });

</script>